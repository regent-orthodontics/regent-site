---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const siteUrl = 'https://regentorthodontics.com';
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;

const dentistSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  'name': 'Regent Orthodontics',
  'image': `${siteUrl}/og.png`,
  'url': siteUrl,
  'telephone': '',
  'email': 'admin@regentorthodontics.com',
  'priceRange': 'NHS + Private',
  'medicalSpecialty': 'Orthodontics',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': '11 Regent Street',
    'addressLocality': 'Newtownards',
    'addressRegion': 'County Down',
    'postalCode': 'BT23 4AB',
    'addressCountry': 'GB'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 54.5910,
    'longitude': -5.6920
  },
  'areaServed': [
    { '@type': 'City', 'name': 'Newtownards' },
    { '@type': 'City', 'name': 'Bangor' },
    { '@type': 'City', 'name': 'Comber' },
    { '@type': 'City', 'name': 'Holywood' },
    { '@type': 'AdministrativeArea', 'name': 'Ards and North Down' }
  ],
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday','Tuesday','Wednesday','Thursday','Friday'],
      'opens': '09:00',
      'closes': '17:30'
    }
  ],
  'sameAs': []
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Regent Orthodontics" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={`${siteUrl}/og.png`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/og.png`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script type="application/ld+json" set:html={JSON.stringify(dentistSchema)} />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --brand-deep: #14506b;
    --brand-teal: #2e8b9e;
    --brand-soft: #6fa7bd;
    --brand-bg:   #fbfcfd;
    --text-strong:#1f2933;
    --text-soft:  #3b4a57;
    --text-mute:  #5b6b78;
    --border:     #cdd9e0;
    --max-w:      1140px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-strong);
    line-height: 1.55;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--brand-teal); text-decoration: none; }
  a:hover { color: var(--brand-deep); }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3, h4 {
    color: var(--brand-deep);
    line-height: 1.2;
    margin: 0 0 0.6em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
