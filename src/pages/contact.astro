---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Map from '../components/Map.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../../site.config.mjs';
const a = site.contact.address;
const c = site.services.find((s) => s.slug === 'consultation');
---
<Base title="Book a consultation"
      description="Book an orthodontic consultation at Regent Orthodontics, 11 Regent Street, Newtownards BT23 4AB. No referral needed.">
  <PageHead eyebrow="Book a consultation"
            title={site.formEndpoint ? 'Tell us how to reach you.' : 'Write, and we will ring you back.'}
            lede={site.formEndpoint
              ? 'Leave your details and the practice will contact you to arrange the appointment. Nothing is booked online and nothing is charged — the consultation is free, and the appointment is agreed when we speak.'
              : 'There is no online booking yet, and no form on this page that pretends to be one. Send us an email and a number to reach you on, and the practice will telephone you to arrange the appointment.'} />

  <section>
    <div class="wrap">
      <EnquiryForm />

      <div class="ways">
        <div class="way panel">
          <p class="wl">{site.formEndpoint ? 'Or by email' : 'By email'}</p>
          <p class="big"><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
          <p class="hrs">Tell us your name, a number to reach you on and roughly when suits.
            We will ring you back to book the appointment, {site.hours[0].days.replace('-', ' to ')}
            {' '}{site.hours[0].open} to {site.hours[0].close}.</p>
          <p class="warnbar small"><span>Please do not send medical details or photographs by
            email — it is not a secure channel. Bring them with you instead.</span></p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="find">
    <div class="wrap">
      <div class="cols">
        <div>
          <p class="eyebrow">Where we are</p>
          <h2>{a.street}</h2>
          <address>
            {a.locality}<br />{a.region} {a.postcode}
          </address>
          <Map height={420} />
        </div>

        <div class="expect panel">
          <h3>What you are booking</h3>
          <p class="ln"><span>{c.name}</span></p>
          <p class="d">{c.description}</p>
          <p class="link"><a href="/first-visit">What happens at the first visit →</a></p>
          <p class="link"><a href="/fees">All fees →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="dentists">
    <div class="wrap">
      <div class="panel row">
        <div>
          <h2>Referring a patient?</h2>
          <p>Dentists have their own page — what we accept, what to include and how we report back.</p>
        </div>
        <a class="btn ghost" href="/referrals">Referral information</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ways{margin-top:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:22px;
        max-width:560px}
  .wl{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;
      color:var(--gold-text);margin:0 0 16px}
  .big{font-family:var(--serif);font-size:clamp(24px,3vw,31px);margin:0;line-height:1.2;
       word-break:break-word}
  .big a{text-decoration:none}
  .big a:hover{color:var(--gold-dim)}
  .hrs{margin:20px 0 0;font-size:14.5px;color:var(--soft);padding-top:18px;
       border-top:1px solid var(--line)}
  .warnbar.small{margin-top:20px;font-size:13.5px;padding:13px 16px}

  .find .cols{display:grid;grid-template-columns:1fr 340px;gap:52px;align-items:start}
  .find h2{font-size:clamp(26px,3.4vw,38px);margin:14px 0 16px}
  .find address{font-style:normal;color:var(--soft);font-size:16.5px;line-height:1.7;
                margin-bottom:26px}
  .expect h3{font-size:12px;font-family:var(--mono);letter-spacing:.14em;text-transform:uppercase;
             color:var(--gold-text);margin:0 0 20px;font-weight:400}
  .expect .ln{display:flex;justify-content:space-between;gap:16px;align-items:baseline;margin:0;
              padding-bottom:14px;border-bottom:1px solid var(--line)}
  .expect .ln span:first-child{font-size:16.5px}
  .expect .d{color:var(--soft);font-size:14.5px;margin:16px 0 22px}
  .expect .link{margin:0 0 8px;font-size:14.5px}
  .expect .link a{color:var(--gold-dim);text-decoration:none}

  .dentists{padding-top:0}
  .row{display:flex;gap:30px;justify-content:space-between;align-items:center;flex-wrap:wrap}
  .row h2{font-size:23px;margin:0 0 8px}
  .row p{color:var(--soft);font-size:15.5px;margin:0;max-width:56ch}

  @media (max-width:900px){.find .cols{grid-template-columns:1fr;gap:34px}}
</style>
