---
import { SITE, WAITLIST_ENDPOINT } from '../config';

const title = `Register your interest — Regent Orthodontics · Opening ${SITE.openingMonth}`;
const description = `Join the Regent Orthodontics waitlist. We'll contact you once consultations open at 11 Regent Street, Newtownards.`;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#1a1816" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE.url}/register`} />
  <meta name="robots" content="noindex, nofollow" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="Register your interest · Regent Orthodontics" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${SITE.url}/register`} />
  <meta property="og:image" content={`${SITE.url}/clinic.png`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="stage">

    <a href="/" class="back" aria-label="Back to home">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>Back</span>
    </a>

    <div class="frame">

      <header class="hero">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Pre-opening · Newtownards
        </p>
        <h1 class="headline">
          Be among the first<br/>
          to <em>book a consultation.</em>
        </h1>
        <p class="lede">
          Leave your details and we'll be in touch to schedule your first appointment as soon as the clinic opens in {SITE.openingMonth}. No payment, no commitment.
        </p>
      </header>

      <form id="waitlist-form" class="form" novalidate>
        <div class="row two">
          <label class="field">
            <span class="label">First name<span class="req" aria-hidden="true">*</span></span>
            <input name="firstName" type="text" required autocomplete="given-name" />
          </label>
          <label class="field">
            <span class="label">Last name<span class="req" aria-hidden="true">*</span></span>
            <input name="lastName" type="text" required autocomplete="family-name" />
          </label>
        </div>

        <div class="row two">
          <label class="field">
            <span class="label">Email<span class="req" aria-hidden="true">*</span></span>
            <input name="email" type="email" required autocomplete="email" inputmode="email" />
          </label>
          <label class="field">
            <span class="label">Mobile <span class="opt">(optional)</span></span>
            <input name="mobile" type="tel" autocomplete="tel" inputmode="tel" placeholder="+44 …" />
          </label>
        </div>

        <fieldset class="row choices">
          <legend class="label">Treatment route<span class="req" aria-hidden="true">*</span></legend>
          <div class="chips">
            <label class="chip"><input type="radio" name="patientType" value="NHS" required /><span>NHS / HSC</span></label>
            <label class="chip"><input type="radio" name="patientType" value="Private" /><span>Private</span></label>
            <label class="chip"><input type="radio" name="patientType" value="Not sure" /><span>Not sure yet</span></label>
          </div>
        </fieldset>

        <fieldset class="row choices">
          <legend class="label">Patient age<span class="req" aria-hidden="true">*</span></legend>
          <div class="chips">
            <label class="chip"><input type="radio" name="ageGroup" value="Adult" required /><span>Adult (18+)</span></label>
            <label class="chip"><input type="radio" name="ageGroup" value="Teen" /><span>Teen (12–17)</span></label>
            <label class="chip"><input type="radio" name="ageGroup" value="Child" /><span>Child (under 12)</span></label>
          </div>
        </fieldset>

        <label class="field">
          <span class="label">Anything we should know? <span class="opt">(optional)</span></span>
          <textarea name="notes" rows="3" maxlength="600" placeholder="Main concern, urgency, referral source…"></textarea>
        </label>

        <label class="consent">
          <input type="checkbox" name="gdprConsent" required />
          <span>
            I consent to Regent Orthodontics holding the details above so they can contact me about availability of an initial consultation. I understand I can withdraw this consent at any time by replying <em>unsubscribe</em> to any email from the practice. See our <a href="/privacy">privacy notice</a>.
          </span>
        </label>

        <button type="submit" class="submit">
          <span class="submit-label">Register my interest</span>
          <svg class="submit-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </button>

        <p class="legal-note">
          Specialist Orthodontist · Dr Diego Chavesta Rivadeneyra · GDC&nbsp;{SITE.gdc.diego}<br/>
          Orthodontic Therapist · Yesica Alves Barreto · GDC&nbsp;{SITE.gdc.yesica}<br/>
          Trading name of {SITE.legalName} ({SITE.companyNumber})
        </p>
      </form>

      <div id="success-state" class="success" hidden>
        <div class="success-mark" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </div>
        <h2>You're on the list.</h2>
        <p>Thank you. We'll be in touch from <strong>admin@regentorthodontics.com</strong> as soon as we open consultation slots.</p>
        <a href="/" class="quiet-link">← Back to home</a>
      </div>

    </div>
  </main>

  <script define:vars={{ WAITLIST_ENDPOINT }}>
    const form = document.getElementById('waitlist-form');
    const success = document.getElementById('success-state');
    const submitBtn = form.querySelector('.submit');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      const labelEl = submitBtn.querySelector('.submit-label');
      const originalLabel = labelEl.textContent;
      labelEl.textContent = 'Sending…';

      const fd = new FormData(form);
      const payload = {
        firstName: (fd.get('firstName') || '').toString().trim(),
        lastName: (fd.get('lastName') || '').toString().trim(),
        email: (fd.get('email') || '').toString().trim(),
        mobile: (fd.get('mobile') || '').toString().trim(),
        patientType: (fd.get('patientType') || '').toString(),
        ageGroup: (fd.get('ageGroup') || '').toString(),
        notes: (fd.get('notes') || '').toString().trim(),
        gdprConsent: fd.get('gdprConsent') === 'on',
        source: 'website',
        ua: navigator.userAgent,
      };

      try {
        // Using text/plain + no-cors avoids the CORS preflight against Apps Script.
        // We can't read the response, but the doPost will still execute and append the row.
        await fetch(WAITLIST_ENDPOINT, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        labelEl.textContent = originalLabel;
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
        alert('Something went wrong sending the form. Please email us directly at admin@regentorthodontics.com — we\'ll add you manually.');
      }
    });
  </script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #1a1816;
      color: #f0ebe0;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      font-feature-settings: 'kern' 1, 'liga' 1, 'ss01' 1;
      min-height: 100vh;
    }
    ::selection { background: #b8956a; color: #1a1816; }
    a { color: inherit; text-decoration: none; }
    *:focus { outline: none; }
    *:focus-visible {
      outline: 1.5px solid #d4b88a;
      outline-offset: 4px;
      border-radius: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        transition-duration: 0.001ms !important;
      }
    }
  </style>

  <style>
    :root {
      --ink: #1a1816;
      --ink-soft: #221f1c;
      --cream: #f5f0e8;
      --paper: #f0ebe0;
      --gold: #b8956a;
      --gold-light: #d4b88a;
      --gold-dim: #8a7155;
      --mute: #8a847b;
      --line: rgba(212, 184, 138, 0.14);
      --line-strong: rgba(212, 184, 138, 0.35);
      --field-bg: #221e1a;
      --field-border: #2e2924;
      --field-border-focus: #b8956a;
      --error: #c66a4e;
    }

    .stage {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      justify-content: center;
      padding: clamp(40px, 6vh, 72px) clamp(20px, 4vw, 48px);
      background:
        radial-gradient(900px 500px at 50% -10%, rgba(184, 149, 106, 0.07), transparent 60%),
        var(--ink);
    }

    .back {
      position: absolute;
      top: clamp(20px, 3vh, 32px);
      left: clamp(20px, 4vw, 40px);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--mute);
      font-weight: 500;
      transition: color 0.25s ease;
    }
    .back:hover { color: var(--gold-light); }

    .frame {
      width: 100%;
      max-width: 580px;
    }

    /* Hero */
    .hero {
      text-align: center;
      margin-bottom: clamp(40px, 6vh, 64px);
      padding-top: clamp(24px, 5vh, 56px);
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold-light);
      font-weight: 500;
      margin-bottom: 22px;
    }
    .dot {
      width: 6px; height: 6px; border-radius: 50%; background: var(--gold);
      animation: pulse 2.4s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50%      { opacity: 1;    transform: scale(1.25); }
    }
    .headline {
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 380;
      font-size: clamp(30px, 4.6vw, 44px);
      line-height: 1.1;
      letter-spacing: -0.018em;
      color: var(--paper);
      font-variation-settings: 'opsz' 144, 'SOFT' 30;
      margin: 0 auto 20px;
      max-width: 18ch;
    }
    .headline em {
      font-style: italic;
      color: var(--gold-light);
      font-weight: 360;
      font-variation-settings: 'opsz' 144, 'SOFT' 100;
    }
    .lede {
      font-size: 15px;
      line-height: 1.6;
      color: #cbc3b8;
      max-width: 50ch;
      margin: 0 auto;
    }

    /* Form */
    .form {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .row.two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .label {
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--mute);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .req { color: var(--gold); font-weight: 600; }
    .opt {
      letter-spacing: 0.04em;
      text-transform: none;
      font-size: 11px;
      color: var(--gold-dim);
      font-weight: 400;
    }
    input[type="text"],
    input[type="email"],
    input[type="tel"],
    textarea {
      font-family: inherit;
      font-size: 15px;
      color: var(--paper);
      background: var(--field-bg);
      border: 1px solid var(--field-border);
      border-radius: 8px;
      padding: 13px 14px;
      transition: border-color 0.2s ease, background 0.2s ease;
      width: 100%;
    }
    input::placeholder, textarea::placeholder { color: #6f6862; }
    input:hover, textarea:hover { border-color: #3a342e; }
    input:focus, textarea:focus {
      border-color: var(--field-border-focus);
      background: #261f1a;
      outline: none;
    }
    textarea { resize: vertical; min-height: 86px; line-height: 1.5; }
    input:invalid:not(:placeholder-shown) { border-color: var(--error); }

    .choices { border: 0; }
    legend.label { margin-bottom: 10px; }
    .chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      cursor: pointer;
      position: relative;
    }
    .chip input { position: absolute; opacity: 0; pointer-events: none; }
    .chip span {
      display: inline-block;
      padding: 11px 18px;
      font-size: 13.5px;
      color: var(--paper);
      background: var(--field-bg);
      border: 1px solid var(--field-border);
      border-radius: 999px;
      transition: all 0.2s ease;
      font-weight: 400;
    }
    .chip:hover span { border-color: #3a342e; color: var(--gold-light); }
    .chip input:checked + span {
      background: var(--gold);
      color: var(--ink);
      border-color: var(--gold);
      font-weight: 500;
    }
    .chip input:focus-visible + span {
      outline: 1.5px solid var(--gold-light);
      outline-offset: 3px;
    }

    .consent {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 12.5px;
      line-height: 1.55;
      color: #b8b0a4;
      padding: 6px 0;
      cursor: pointer;
    }
    .consent input {
      flex: 0 0 18px;
      width: 18px; height: 18px;
      margin-top: 1px;
      accent-color: var(--gold);
      cursor: pointer;
    }
    .consent a {
      color: var(--gold-light);
      border-bottom: 1px solid transparent;
      transition: border-color 0.25s ease;
    }
    .consent a:hover { border-color: var(--gold-light); }
    .consent em { font-style: italic; color: var(--paper); }

    .submit {
      margin-top: 6px;
      font-family: inherit;
      font-size: 14px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--ink);
      background: var(--gold);
      border: none;
      border-radius: 10px;
      padding: 17px 24px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      transition: background 0.25s ease, transform 0.15s ease;
    }
    .submit:hover { background: var(--gold-light); }
    .submit:active { transform: scale(0.985); }
    .submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .submit-arrow { transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1); }
    .submit:hover .submit-arrow { transform: translateX(4px); }
    .submit.loading .submit-arrow { opacity: 0; }

    .legal-note {
      margin-top: 24px;
      font-size: 11px;
      line-height: 1.7;
      color: var(--mute);
      text-align: center;
      letter-spacing: 0.02em;
    }

    /* Success */
    .success {
      text-align: center;
      padding: clamp(40px, 8vh, 96px) 8px;
    }
    .success-mark {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--ink);
      margin: 0 auto 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: pop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1.05) backwards;
    }
    @keyframes pop {
      0% { opacity: 0; transform: scale(0.6); }
      100% { opacity: 1; transform: scale(1); }
    }
    .success h2 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: clamp(26px, 3.8vw, 36px);
      font-variation-settings: 'opsz' 144, 'SOFT' 40;
      color: var(--paper);
      font-weight: 400;
      margin-bottom: 16px;
      letter-spacing: -0.01em;
    }
    .success p {
      font-size: 15px;
      line-height: 1.6;
      color: #cbc3b8;
      max-width: 42ch;
      margin: 0 auto 32px;
    }
    .success strong { color: var(--gold-light); font-weight: 500; }
    .quiet-link {
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--mute);
      transition: color 0.25s ease;
    }
    .quiet-link:hover { color: var(--gold-light); }

    /* Mobile */
    @media (max-width: 600px) {
      .row.two { grid-template-columns: 1fr; gap: 18px; }
      .chips { gap: 6px; }
      .chip span { padding: 10px 14px; font-size: 13px; }
      .back { font-size: 11px; }
      .form { gap: 20px; }
      .eyebrow {
        font-size: 10px;
        letter-spacing: 0.22em;
        text-align: center;
        line-height: 1.4;
      }
      .lede { font-size: 14px; }
      .hero { margin-bottom: 36px; }
    }
  </style>
</body>
</html>
