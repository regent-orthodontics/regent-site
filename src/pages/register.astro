---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
// Esta ruta existía en la landing de pre-apertura y estaba en su sitemap,
// así que la conserva el sitio nuevo: quien la tenga guardada o la
// encuentre en Google sigue llegando a un formulario y no a un 404.
//
// El QR del vallado y de la puerta apunta a la raíz del dominio, no aquí
// —está verificado leyendo los seis ficheros—, así que quien escanea entra
// por la portada y llega por la tercera tarjeta. Esta página es el destino
// de ese recorrido, no del código.
---
<Base title="Register your interest"
      description="Register your interest in orthodontic treatment at Regent Orthodontics, Newtownards. Leave your details and the practice will be in touch to arrange an appointment.">
  <PageHead eyebrow="Register your interest"
            title="Join the list before we open."
            lede="The practice does not open to patients until the Regulation and Quality Improvement Authority has granted registration. Leave your details now and we will be in touch to arrange an appointment as soon as it does." />

  <section>
    <div class="wrap">
      <EnquiryForm />

      <div class="panel next">
        <h2>What registering does</h2>
        <ul class="ticks">
          <li><span>It puts you on the list, and nothing more. No appointment is booked and
            nothing is charged</span></li>
          <li><span>We contact you to agree a time — you are not committing to treatment by
            leaving your details</span></li>
          <li><span>The consultation itself is free, and nothing is fitted or decided on the
            day</span></li>
        </ul>
      </div>

      <p class="also">You may want to read
        {' '}<a href="/first-visit">what happens at the first visit</a> or
        {' '}<a href="/fees">what treatment costs</a>.</p>

      <p class="quiet">We keep your details to arrange the appointment and for nothing else. If it
        does not go ahead, they are deleted after twelve months —
        {' '}<a href="/privacy">how we handle your information</a>.</p>
    </div>
  </section>
</Base>

<style>
  .next{padding:32px 30px;margin-top:30px;max-width:66ch}
  .next h2{font-size:21px;margin:0 0 20px}
  .also{margin-top:30px;max-width:66ch}
  .quiet{font-size:14.5px;margin-top:20px;color:var(--soft);max-width:66ch}
  .also a,.quiet a{color:var(--gold-dim)}
</style>
