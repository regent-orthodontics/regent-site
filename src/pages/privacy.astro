---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../../site.config.mjs';
const p = site.privacy;
const a = site.contact.address;
---
<Base title="Website privacy notice"
      description="What Regent Orthodontics does with your information when you enquire through this website, telephone the practice or simply visit: what we collect, why, how long we keep it and your rights.">
  <PageHead eyebrow="Privacy"
            title="What happens to your information."
            lede="This page is about the website — what we collect when you enquire, telephone us or simply visit, why we are allowed to, and what you can ask us to do about it." />

  <section>
    <div class="wrap prose narrow">
      {p.confirmed === false && (
        <p class="warnbar"><span>{p.draftNote}</span></p>
      )}

      {/* El paciente que busca qué pasa con su historia clínica llega aquí.
           Decirle en la primera línea que ese documento existe y dónde se lo
           dan es más útil que dejarle leer una página que no es la suya. */}
      <p class="hand">{p.patientNotice}</p>

      <div class="blk">
        <h2>Who is responsible</h2>
        <p>{p.controller}, {a.street}, {a.locality}, {a.postcode}. Registered in Northern Ireland
          no. {site.legal.companyNumber}. We are the data controller for the information described
          here and are registered with the {p.ico.name} under registration number
          {' '}<strong>{p.ico.registration}</strong>.</p>
        <p>This notice applies to {p.scope}. Write to
          {' '}<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> about anything on
          this page.</p>
      </div>

      <div class="blk">
        <h2>What we collect, and why</h2>
        {p.collect.map((c) => (
          <div class="case">
            <h3>{c.heading}</h3>
            <p>{c.text}</p>
            {c.basis && <p class="basis">{c.basis}</p>}
          </div>
        ))}
        <p class="em">{p.noSell}</p>
      </div>

      <div class="blk">
        <h2>Who else sees it</h2>
        <ul class="ticks">{p.sharing.map((i) => <li><span>{i}</span></li>)}</ul>
        <p>{p.sharingNote}</p>
      </div>

      <div class="blk">
        <h2>How long we keep it</h2>
        <ul class="ticks">{p.retention.map((i) => <li><span>{i}</span></li>)}</ul>
      </div>

      <div class="blk">
        <h2>Cookies</h2>
        <p>{p.cookies}</p>
      </div>

      <div class="blk">
        <h2>Your rights</h2>
        <p>You have the right to:</p>
        <ul class="ticks">{p.rights.map((i) => <li><span>{i}</span></li>)}</ul>
        <p>{p.rightsNote}</p>
        <p>{p.complaintProcess}</p>
        <p>{p.ico.note} The {p.ico.name} is at
          {' '}<a href={p.ico.url} rel="noopener">{p.ico.url.replace(/^https?:\/\//, '')}</a>,
          {' '}{p.ico.phone}.</p>
      </div>

      <div class="blk">
        <h2>Changes to this notice</h2>
        <p>{p.changes}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow{max-width:72ch}
  .blk{padding:34px 0;border-top:1px solid var(--line)}
  .prose a{color:var(--gold-dim)}
  .prose .em{color:var(--ink);font-weight:500;margin-top:22px}
  .warnbar{margin-bottom:30px}
  /* El puntero al aviso de paciente va antes que nada y no parece una nota
     al pie: quien viene buscando su historia clínica tiene que verlo. */
  .hand{border-left:2px solid var(--gold);padding:2px 0 2px 20px;color:var(--ink-soft);
        font-size:16px;max-width:66ch;margin-bottom:8px}
  .case{padding:22px 0;border-bottom:1px solid var(--line)}
  .case:last-of-type{border-bottom:0;padding-bottom:0}
  .case h3{font-size:17.5px;font-family:var(--sans);font-weight:600;margin:0 0 10px}
  .basis{font-size:14.5px;padding-left:18px;border-left:1px solid var(--line);margin-top:12px}
</style>
