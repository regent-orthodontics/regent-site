---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Regent Orthodontics — Specialist Orthodontist Newtownards · NHS & Private';
const description = 'Specialist-led orthodontic clinic on Regent Street, Newtownards. NHS & private treatment for children and adults — braces, clear aligners, retainers. Now accepting new patients across Ards & North Down. Opening November 2026.';
---

<BaseLayout {title} {description}>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark">RO</span>
        <span class="brand-name">Regent Orthodontics</span>
      </a>
      <nav class="nav">
        <a href="#treatments">Treatments</a>
        <a href="#about">About</a>
        <a href="#fees">Fees</a>
        <a href="#referrals">Referrals</a>
        <a href="#contact" class="cta-mini">Book a consultation</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap hero-inner">
      <p class="kicker">Specialist Orthodontist · Newtownards · BT23 4AB</p>
      <h1>Specialist orthodontic care<br/>for the Ards and North Down.</h1>
      <p class="lede">
        A purpose-built specialist clinic on Regent Street, Newtownards. NHS and private treatment for children, teens and adults — fixed braces, clear aligners, retainers and complex care, led by a GDC-registered Specialist in Orthodontics.
      </p>
      <p class="hero-cta">
        <a href="#contact" class="btn-primary">Book a free consultation</a>
        <a href="#referrals" class="btn-secondary">Refer a patient</a>
      </p>
      <p class="hero-meta">Opening November 2026 · NHS (HSC) + Private from day one</p>
    </div>
  </section>

  <section class="strip">
    <div class="wrap strip-grid">
      <div><strong>GDC-registered</strong> Specialist Orthodontist (#206244)</div>
      <div><strong>NHS + Private</strong> from day one</div>
      <div><strong>Two clinicians</strong> · Specialist + Orthodontic Therapist</div>
      <div><strong>Now accepting</strong> new patients across Ards &amp; North Down</div>
    </div>
  </section>

  <section id="treatments" class="section">
    <div class="wrap">
      <h2>Treatments</h2>
      <p class="section-lede">Specialist orthodontic care for every age, every smile.</p>
      <div class="cards">
        <article class="card">
          <h3>Children &amp; teens</h3>
          <p>Early interceptive treatment, fixed braces and clear aligners for growing patients — NHS funded under HSC for IOTN 4/5 cases.</p>
        </article>
        <article class="card">
          <h3>Adult orthodontics</h3>
          <p>Clear aligners, lingual and tooth-coloured braces. Private treatment plans tailored to lifestyle and outcome goals.</p>
        </article>
        <article class="card">
          <h3>Complex &amp; orthognathic</h3>
          <p>Multidisciplinary planning for severe malocclusion, surgical orthodontics and joint cases with restorative colleagues.</p>
        </article>
        <article class="card">
          <h3>Retainers &amp; review</h3>
          <p>Long-term retention plans, replacement retainers and post-treatment reviews — protecting your investment for life.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="section section-alt">
    <div class="wrap">
      <h2>Specialist-led, family-owned.</h2>
      <p>Regent Orthodontics is a family-owned, specialist orthodontic clinic in central Newtownards. Founded by Dr Diego Chavesta-Rivadeneyra — a UK-registered Specialist in Orthodontics with over a decade of clinical experience — and co-director Yesica Alves Barreto, a GDC-registered Orthodontic Therapist and Practice Manager.</p>
      <p>We exist for one reason: to make excellent, modern orthodontic care available locally in the Ards and North Down area, without long referral journeys to Belfast.</p>
    </div>
  </section>

  <section id="fees" class="section">
    <div class="wrap">
      <h2>Fees &amp; funding</h2>
      <p class="section-lede">Transparent pricing. NHS and private pathways clearly explained at your first visit.</p>
      <p class="placeholder">Detailed fee schedule will be published before opening. For an indicative quote, please contact us.</p>
    </div>
  </section>

  <section id="referrals" class="section section-alt">
    <div class="wrap">
      <h2>For GDPs &amp; referrers</h2>
      <p>We accept private and NHS referrals from general dental practitioners across Ards, North Down and Belfast. A dedicated referrer portal with secure document upload will go live before opening — in the meantime, please email referrals to <a href="mailto:referrals@regentorthodontics.com">referrals@regentorthodontics.com</a> or call the practice.</p>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap">
      <h2>Contact &amp; visit us</h2>
      <div class="contact-grid">
        <div>
          <h3>Address</h3>
          <p>11 Regent Street<br/>Newtownards<br/>County Down · BT23 4AB<br/>Northern Ireland</p>
        </div>
        <div>
          <h3>Email</h3>
          <p><a href="mailto:admin@regentorthodontics.com">admin@regentorthodontics.com</a></p>
          <h3>Hours (from opening)</h3>
          <p>Monday – Friday<br/>09:00 – 17:30</p>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div>
        <strong>Regent Orthodontics</strong><br/>
        Trading name of DY Destiny Limited (NI695932)<br/>
        Registered in Northern Ireland · GDC #206244
      </div>
      <div class="footer-meta">
        © {new Date().getFullYear()} DY Destiny Limited · All rights reserved
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .wrap { max-width: var(--max-w); margin: 0 auto; padding: 0 24px; }

  /* Topbar */
  .topbar {
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.96);
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: saturate(180%) blur(8px);
  }
  .topbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 64px;
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--brand-deep); font-weight: 700; }
  .brand-mark {
    width: 34px; height: 34px; display: grid; place-items: center;
    background: var(--brand-deep); color: #fff; border-radius: 7px;
    font-size: 13px; letter-spacing: 0.05em;
  }
  .brand-name { font-size: 16px; }
  .nav { display: flex; gap: 22px; align-items: center; font-size: 14px; }
  .nav a { color: var(--text-soft); }
  .nav a.cta-mini {
    background: var(--brand-deep); color: #fff; padding: 8px 14px; border-radius: 6px;
  }
  .nav a.cta-mini:hover { background: var(--brand-teal); color: #fff; }

  /* Hero */
  .hero {
    background:
      radial-gradient(1200px 400px at 80% -20%, rgba(46,139,158,0.18), transparent 60%),
      linear-gradient(180deg, #f4f8fa 0%, #fff 100%);
    padding: 88px 0 96px;
  }
  .kicker {
    color: var(--brand-teal); font-weight: 700; font-size: 12px;
    letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 18px;
  }
  .hero h1 {
    font-size: clamp(34px, 5vw, 56px);
    color: var(--brand-deep);
    margin: 0 0 22px;
    max-width: 22ch;
  }
  .lede { font-size: clamp(16px, 1.4vw, 19px); color: var(--text-soft); max-width: 62ch; margin: 0 0 28px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin: 0 0 18px; }
  .btn-primary, .btn-secondary {
    display: inline-block; padding: 14px 22px; border-radius: 8px;
    font-weight: 600; font-size: 15px;
  }
  .btn-primary { background: var(--brand-deep); color: #fff; }
  .btn-primary:hover { background: var(--brand-teal); color: #fff; }
  .btn-secondary { background: #fff; color: var(--brand-deep); border: 1.5px solid var(--brand-deep); }
  .btn-secondary:hover { background: var(--brand-deep); color: #fff; }
  .hero-meta { font-size: 13px; color: var(--text-mute); margin-top: 18px; }

  /* Strip */
  .strip {
    background: var(--brand-deep);
    color: #fff; padding: 18px 0; font-size: 14px;
  }
  .strip-grid {
    display: grid; gap: 18px;
    grid-template-columns: repeat(4, 1fr);
  }
  .strip strong { color: #fff; }
  @media (max-width: 800px) { .strip-grid { grid-template-columns: 1fr 1fr; } .nav { display: none; } }

  /* Sections */
  .section { padding: 80px 0; }
  .section h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 12px; }
  .section-lede { color: var(--text-soft); max-width: 60ch; margin: 0 0 32px; font-size: 17px; }
  .section-alt { background: #f4f8fa; }

  .cards {
    display: grid; gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card {
    background: #fff; border: 1px solid var(--border); border-radius: 10px;
    padding: 22px 22px 20px;
  }
  .card h3 { font-size: 18px; color: var(--brand-deep); margin: 0 0 8px; }
  .card p { margin: 0; color: var(--text-soft); font-size: 14.5px; }

  .placeholder { color: var(--text-mute); font-style: italic; }

  .contact-grid {
    display: grid; gap: 28px;
    grid-template-columns: 1fr 1fr;
  }
  .contact-grid h3 { font-size: 16px; color: var(--brand-deep); margin: 0 0 6px; }
  .contact-grid p { margin: 0 0 18px; color: var(--text-soft); }
  @media (max-width: 600px) { .contact-grid { grid-template-columns: 1fr; } }

  /* Footer */
  .footer {
    background: #14506b; color: #cdd9e0; padding: 32px 0; font-size: 13px;
  }
  .footer-inner {
    display: flex; justify-content: space-between; gap: 22px; flex-wrap: wrap;
  }
  .footer-meta { color: #8ea4af; }
</style>
