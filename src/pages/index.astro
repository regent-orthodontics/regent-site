---
import Base from '../layouts/Base.astro';
import BracketHero from '../components/BracketHero.astro';
import { site } from '../../site.config.mjs';
const money = (n) => new Intl.NumberFormat('en-GB', { style:'currency', currency:'GBP', maximumFractionDigits:0 }).format(n);
const svc = site.services.filter((s) => s.slug);
---
<Base>
  <BracketHero />

  {/* Las dos puertas. Un ortodoncista especialista tiene dos públicos que no
       se parecen en nada: el padre que busca precio y plazos, y el dentista que
       necesita criterios de derivación. Mandarlos a la misma página es fallarle
       a los dos. */}
  <section class="doors">
    <div class="wrap">
      <p class="eyebrow">Where would you like to start?</p>
      <h2>Three ways in</h2>

      <div class="two">
        <article class="door">
          <p class="tag">For patients &amp; parents</p>
          <h3>I'm looking for treatment</h3>
          <p>For yourself or for your child. Start with what the treatment involves, how long it
            takes and what it costs.</p>
          <ul>
            <li>Orthodontic consultation and clinical records</li>
            <li>Fixed appliances</li>
            <li>Clear aligners</li>
          </ul>
          <a class="btn" href="/fees">See treatments &amp; fees</a>
        </article>

        <article class="door">
          <p class="tag">For referring dentists</p>
          <h3>I'm referring a patient</h3>
          <p>Direct access to the specialist and clear acceptance criteria.</p>
          <ul>
            <li>What we accept — and what we don't</li>
            <li>Secure referral for records and radiographs</li>
            <li>Your patient stays with you for their general care</li>
          </ul>
          <a class="btn gold" href="/referrals">Referral information</a>
        </article>

        <article class="door">
          <p class="tag">Before we open</p>
          <h3>I'd like to register</h3>
          <p>Leave your details now and the practice will be in touch to arrange an appointment
            as soon as it opens.</p>
          <ul>
            <li>No appointment booked and nothing charged</li>
            <li>The first consultation is free</li>
            <li>We contact you to agree a time</li>
          </ul>
          <a class="btn ink" href="/register">Register your interest</a>
        </article>
      </div>
    </div>
  </section>

</Base>

<style>
  .doors{background:var(--cream);border-bottom:1px solid var(--line)}
  .doors h2{font-size:clamp(30px,4.4vw,50px);margin:14px 0 0}
  /* Con dos puertas, auto-fit valía: daba dos columnas o una. Con tres deja
     un tramo ancho —de unos 720px a 1100px, que es un portátil cualquiera—
     donde caben dos y la tercera se queda sola con medio hueco al lado.
     Tres o una, nunca dos. */
  .two{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:44px}
  @media (max-width:900px){.two{grid-template-columns:1fr;max-width:640px}}
  .door{border:1px solid var(--line);border-radius:16px;padding:38px 34px;background:var(--paper);
        display:flex;flex-direction:column;gap:14px}
  .door .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;
             color:var(--gold-text);margin:0}
  .door h3{font-size:26px}
  .door p{color:var(--soft);font-size:15.5px}
  .door ul{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:11px;
           font-size:15px;color:var(--soft);border-top:1px solid var(--line);padding-top:22px;
           margin-bottom:6px}
  .door li{display:flex;gap:11px}
  .door li::before{content:"";flex:none;width:5px;height:5px;border-radius:50%;
                   background:var(--gold);margin-top:9px}
  /* margin-top:auto pega el botón al fondo de su tarjeta, así los tres
     quedan a la misma altura aunque una lista ocupe una línea más. El
     margen de la lista repone los 20px que antes daba el margin-top fijo:
     14 del gap de la columna más 6. */
  .door .btn{align-self:flex-start;margin-top:auto}
  /* Las tres puertas pesan lo mismo, así que las tres llevan botón sólido y
     se distinguen por color, no por jerarquía. Dentistas va en el dorado
     claro; registro, en tinta, que es el que más contrasta sobre el papel
     — quien llega del QR del vallado viene justo a eso y no debería tener
     que buscarlo. Los tres colores salen de la paleta de la marca. */
  .btn.gold{background:var(--gold-light);border-color:var(--gold-light);color:#3A2E1C}
  .btn.gold:hover{background:var(--gold);border-color:var(--gold-text)}
  .btn.ink{background:var(--ink);border-color:var(--ink);color:var(--cream)}
  .btn.ink:hover{background:var(--ink-soft);border-color:var(--ink-soft)}

</style>
