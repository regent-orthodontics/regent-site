---
const title = 'Regent Orthodontics — Specialist Orthodontic Clinic · Newtownards · Opening December';
const description = "Ards and North Down's first boutique specialist orthodontic clinic. Specialist-led private and NHS treatment, opening on Regent Street, Newtownards in December.";
const siteUrl = 'https://regentorthodontics.com';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  'name': 'Regent Orthodontics',
  'image': `${siteUrl}/clinic.png`,
  'logo': `${siteUrl}/logo.png`,
  'url': siteUrl,
  'email': 'admin@regentorthodontics.com',
  'priceRange': 'NHS + Private',
  'medicalSpecialty': 'Orthodontics',
  'description': description,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': '11 Regent Street',
    'addressLocality': 'Newtownards',
    'addressRegion': 'County Down',
    'postalCode': 'BT23 4AB',
    'addressCountry': 'GB'
  },
  'geo': { '@type': 'GeoCoordinates', 'latitude': 54.5910, 'longitude': -5.6920 },
  'areaServed': [
    { '@type': 'City', 'name': 'Newtownards' },
    { '@type': 'City', 'name': 'Bangor' },
    { '@type': 'City', 'name': 'Comber' },
    { '@type': 'City', 'name': 'Holywood' },
    { '@type': 'AdministrativeArea', 'name': 'Ards and North Down' }
  ],
  'openingHoursSpecification': [{
    '@type': 'OpeningHoursSpecification',
    'dayOfWeek': ['Monday','Tuesday','Wednesday','Thursday','Friday'],
    'opens': '09:00',
    'closes': '17:30'
  }],
  'employee': [
    {
      '@type': 'Person',
      'name': 'Dr Diego Chavesta Rivadeneyra',
      'jobTitle': 'Specialist Orthodontist',
      'identifier': 'GDC 206244'
    },
    {
      '@type': 'Person',
      'name': 'Yesica Alves Barreto',
      'jobTitle': 'Orthodontic Therapist',
      'identifier': 'GDC 269728'
    }
  ]
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#1a1816" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={siteUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="Regent Orthodontics · Newtownards" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:site_name" content="Regent Orthodontics" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={`${siteUrl}/clinic.png`} />
  <meta property="og:image:width" content="1388" />
  <meta property="og:image:height" content="1013" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Regent Orthodontics · Newtownards" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/clinic.png`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="image" href="/clinic.png" fetchpriority="high" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <main class="stage">

    <!-- Left: editorial content -->
    <section class="content" aria-label="Clinic introduction">
      <header class="brand-line" data-reveal="1">
        <img src="/logo.png" alt="Regent Orthodontics" class="brand-mark" width="120" height="120" />
      </header>

      <p class="eyebrow" data-reveal="2">
        <span class="dot" aria-hidden="true"></span>
        Newtownards · Northern Ireland
      </p>

      <h1 class="headline" data-reveal="3">
        Specialist orthodontic care<br/>
        <em>coming&nbsp;soon</em><br/>
        to Regent Street.
      </h1>

      <p class="subtitle" data-reveal="4">
        Ards and North Down's first boutique specialist orthodontic practice. Opening December to private and NHS patients.
      </p>

      <div class="rule" data-reveal="5" aria-hidden="true"></div>

      <dl class="meta" data-reveal="6">
        <div>
          <dt>Address</dt>
          <dd>11 Regent Street<br/>Newtownards · BT23&nbsp;4AB</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd><a href="mailto:admin@regentorthodontics.com">admin@regentorthodontics.com</a></dd>
        </div>
        <div class="team">
          <dt>Clinical team</dt>
          <dd>
            <p class="person">
              <span class="person-name">Dr Diego Chavesta Rivadeneyra</span>
              <span class="person-role">Specialist Orthodontist · <span class="dim">GDC&nbsp;206244</span></span>
            </p>
            <p class="person">
              <span class="person-name">Yesica Alves Barreto</span>
              <span class="person-role">Orthodontic Therapist · <span class="dim">GDC&nbsp;269728</span></span>
            </p>
          </dd>
        </div>
      </dl>

      <footer class="legal" data-reveal="7">
        <span>Trading name of DY Destiny Limited (NI695932)</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>Registered in Northern Ireland</span>
      </footer>
    </section>

    <!-- Right: image hero -->
    <aside class="visual" aria-hidden="true">
      <div class="visual-frame">
        <img src="/clinic.png" alt="" class="clinic-img" width="1388" height="1013" />
        <div class="visual-overlay"></div>
        <div class="visual-grain"></div>
      </div>
      <p class="caption">A render of the future clinic · 11 Regent Street</p>
    </aside>

  </main>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  html, body { height: 100%; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #1a1816;
    color: #f0ebe0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-feature-settings: 'kern' 1, 'liga' 1;
    overflow-x: hidden;
  }
  ::selection { background: #b8956a; color: #1a1816; }
  ::-moz-selection { background: #b8956a; color: #1a1816; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* Focus rings — invisible expensive */
  *:focus { outline: none; }
  *:focus-visible {
    outline: 1.5px solid #d4b88a;
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Motion — respect preferences */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>

<style>
  :root {
    --ink: #1a1816;
    --ink-soft: #2a2521;
    --cream: #f5f0e8;
    --paper: #f0ebe0;
    --gold: #b8956a;
    --gold-light: #d4b88a;
    --gold-dim: #8a7155;
    --mute: #8a847b;
    --line: rgba(212, 184, 138, 0.18);
  }

  .stage {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }

  /* ============ LEFT: editorial content ============ */
  .content {
    padding: 56px clamp(40px, 5vw, 80px) 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    background:
      radial-gradient(800px 400px at 20% 20%, rgba(184, 149, 106, 0.06), transparent 60%),
      var(--ink);
  }

  .brand-line {
    margin-bottom: clamp(40px, 6vh, 64px);
  }
  .brand-mark {
    width: clamp(120px, 14vw, 168px);
    height: auto;
    background: var(--cream);
    border-radius: 14px;
    padding: 10px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-light);
    font-weight: 500;
    margin-bottom: 28px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.25); }
  }

  .headline {
    font-family: 'Fraunces', 'Tiempos Headline', Georgia, serif;
    font-weight: 380;
    font-size: clamp(34px, 5.4vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
    margin-bottom: 26px;
    max-width: 14ch;
  }
  .headline em {
    font-style: italic;
    color: var(--gold-light);
    font-weight: 360;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }

  .subtitle {
    font-size: clamp(15px, 1.05vw, 17px);
    line-height: 1.55;
    color: #cbc3b8;
    max-width: 44ch;
    margin-bottom: 44px;
    font-weight: 400;
  }

  .rule {
    width: 56px;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    margin-bottom: 36px;
  }

  .meta {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) minmax(180px, 1fr);
    grid-template-areas:
      "addr  contact"
      "team  team";
    gap: 28px 36px;
    margin-bottom: clamp(56px, 9vh, 88px);
    max-width: 620px;
  }
  .meta > div:nth-child(1) { grid-area: addr; }
  .meta > div:nth-child(2) { grid-area: contact; }
  .meta > div.team        { grid-area: team; padding-top: 4px; border-top: 1px solid var(--line); margin-top: 4px; }

  .meta dt {
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 10px;
    font-weight: 500;
  }
  .meta dd {
    font-size: 14px;
    line-height: 1.55;
    color: var(--paper);
  }
  .meta dd a {
    color: var(--gold-light);
    position: relative;
    display: inline-block;
  }
  .meta dd a::after {
    content: "";
    position: absolute;
    left: 0; right: 100%; bottom: -2px;
    height: 1px;
    background: var(--gold-light);
    transition: right 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .meta dd a:hover::after { right: 0; }
  .meta .dim { color: var(--mute); font-size: 12px; }

  .team dd {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 36px;
    padding-top: 14px;
  }
  .person {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .person-name {
    font-size: 14px;
    color: var(--paper);
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .person-role {
    font-size: 12.5px;
    color: var(--mute);
    line-height: 1.5;
  }

  .legal {
    font-size: 11px;
    color: var(--mute);
    letter-spacing: 0.04em;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .legal .sep { color: var(--gold-dim); }

  /* ============ RIGHT: image hero ============ */
  .visual {
    position: relative;
    overflow: hidden;
    background: #0e0c0a;
  }
  .visual-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .clinic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, rgba(26,24,22,0.55) 0%, rgba(26,24,22,0.18) 30%, transparent 55%),
      linear-gradient(to top, rgba(26,24,22,0.45) 0%, transparent 35%);
    pointer-events: none;
  }
  .visual-grain {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='200' height='200' filter='url(%23n)' opacity='0.8'/></svg>");
  }
  .caption {
    position: absolute;
    bottom: 22px;
    right: 28px;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.6);
    font-weight: 500;
  }

  /* ============ Reveal-on-load ============ */
  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
  }
  [data-reveal="1"] { animation-delay: 0.05s; }
  [data-reveal="2"] { animation-delay: 0.18s; }
  [data-reveal="3"] { animation-delay: 0.30s; }
  [data-reveal="4"] { animation-delay: 0.48s; }
  [data-reveal="5"] { animation-delay: 0.62s; }
  [data-reveal="6"] { animation-delay: 0.70s; }
  [data-reveal="7"] { animation-delay: 0.86s; }
  @keyframes rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ Mobile — DESIGNED not shrunk ============ */
  @media (max-width: 900px) {
    .stage {
      grid-template-columns: 1fr;
      grid-template-rows: 38vh auto;
    }
    .visual {
      order: -1;
      min-height: 38vh;
    }
    .visual-overlay {
      background:
        linear-gradient(to bottom, transparent 50%, rgba(26,24,22,0.7) 100%);
    }
    .caption { bottom: 14px; right: 18px; font-size: 9.5px; }
    .content {
      padding: 36px 28px 40px;
      justify-content: flex-start;
    }
    .brand-line {
      margin-bottom: 24px;
      margin-top: -56px;
      position: relative;
      z-index: 2;
    }
    .brand-mark {
      width: 132px;
      padding: 10px;
      border-radius: 14px;
      box-shadow: 0 12px 32px rgba(0,0,0,0.4);
    }
    .headline {
      font-size: clamp(28px, 8vw, 40px);
      max-width: 18ch;
      margin-bottom: 18px;
    }
    .subtitle { margin-bottom: 32px; max-width: none; }
    .rule { margin-bottom: 26px; }
    .meta { gap: 22px; margin-bottom: 36px; }
    .legal { font-size: 10.5px; }
  }

  @media (max-width: 480px) {
    .stage { grid-template-rows: 32vh auto; }
    .content { padding: 28px 22px 32px; }
    .brand-line {
      margin-bottom: 20px;
      margin-top: -48px;
    }
    .brand-mark {
      width: 120px;
      padding: 9px;
      border-radius: 12px;
    }
    .headline { font-size: 30px; }
    .meta {
      grid-template-columns: 1fr;
      grid-template-areas:
        "addr"
        "contact"
        "team";
      gap: 20px;
    }
    .team dd {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
